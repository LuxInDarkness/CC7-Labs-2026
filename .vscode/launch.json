{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(gdb) Launch",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/005Threads/005Threads/bin/program.bin",
      "args": [],
      "stopAtEntry": true,
      "cwd": "${fileDirname}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
          {
              "description": "Enable pretty-printing for gdb",
              "text": "-enable-pretty-printing",
              "ignoreFailures": true
          },
          {
              "description": "Set Disassembly Flavor to Intel",
              "text": "-gdb-set disassembly-flavor intel",
              "ignoreFailures": true
          }
      ]
    },
    {
      "name": "Debug ARM926 (QEMU)",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "external",

      "gdbPath": "gdb-multiarch",
      "toolchainPrefix": "arm-none-eabi",

      "showDevDebugOutput": "raw",
      "gdbTarget": "localhost:5000",

      "cwd": "${workspaceFolder}",

      "executable": "${workspaceFolder}/${input:projectName}/Code/bin/program.elf",
      "runToEntryPoint": "main"
    }
  ],

  "inputs": [
    {
      "id": "projectName",
      "type": "pickString",
      "description": "Project: ",
      "options": [
        "001HelloWorld_Qemu",
        "002Calculator",
        "003InterruptHandler"
      ]
    }
  ]
}